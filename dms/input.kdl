input {
    mouse {
        accel-speed 0.0
        accel-profile "flat"
        middle-emulation
    }
    touchpad {
        tap
        accel-speed 0.3
        accel-profile "adaptive"
        natural-scroll
        dwt
        middle-emulation
        scroll-factor 0.7
        scroll-method "two-finger"
    }
}

